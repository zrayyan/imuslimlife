transparent; }}.css-cdn5bg:hover { background-color: rgba(14, 92, 64, 0.04); }@media (hover: none) {.css-cdn5bg:hover { background-color: transparent; }}.css-cdn5bg.Mui-disabled { background-color: transparent; color: rgba(0, 0, 0, 0.26); }.css-vubbuv { user-select: none; width: 1em; height: 1em; display: inline-block; fill: currentcolor; flex-shrink: 0; transition: fill 200ms cubic-bezier(0.4, 0, 0.2, 1); font-size: 1.5rem; }.css-z92prw { display: flex; -webkit-box-align: center; align-items: center; -webkit-box-pack: center; justify-content: center; bottom: calc(80px + env(safe-area-inset-bottom, 0px)); inset-inline-end: max(20px, env(safe-area-inset-right, 0px)); z-index: 1000; background-color: rgb(255, 253, 248); box-shadow: rgba(0, 0, 0, 0.2) 0px 3px 10px; padding: 4px; border-radius: 50%; }@media (min-width: 0px) {.css-z92prw { position: static; }}@media (min-width: 600px) {.css-z92prw { position: fixed; }}","ns":["tasmi"]}